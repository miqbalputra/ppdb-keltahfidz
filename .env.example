# Copy this file to .env for local development; Bun loads .env automatically.
NODE_ENV=development
PORT=8000
DATA_DIR=./data

# MariaDB connection. In Coolify, use the database's internal hostname,
# not localhost (the app and database run in separate containers). Use a
# dedicated database user and a unique password of at least 20 characters.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=waitinglist
DB_USER=waitinglist
DB_PASSWORD=replace-with-a-strong-database-password
DB_SSL=false
# Optional alternative to the DB_* connection fields above.
# DATABASE_URL=mysql://waitinglist:password@127.0.0.1:3306/waitinglist
# Set DB_SSL=true when the MariaDB endpoint supports TLS (especially for a
# database reached outside Coolify's private container network).

# Generate strong values locally and keep them only in your secret manager/Coolify.
# APP_SECRET and DATA_ENCRYPTION_KEY: openssl rand -hex 32
# DATA_ENCRYPTION_KEY must remain stable; losing/changing it makes encrypted data unreadable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_SECRET=
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false

# Initial age policy. Admin can change these settings after deployment.
CUTOFF_DATE=2027-07-01
MIN_AGE_YEARS=6
MIN_AGE_MONTHS=6

# Add the real WhatsApp group invite URL and n8n webhook before launch.
WHATSAPP_GROUP_URL=
N8N_WEBHOOK_URL=

# Optional Cloudflare Turnstile. Set both keys to enable verification.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
